# LLM & Image Generation (OpenAI API: https://developers.openai.com/api/docs/models/gpt-image-2)
OPENAI_API_KEY=sk-proj-your-openai-key
IMAGE_MODEL=gpt-image-2
TEXT_MODEL=gpt-4o

# Printify API (https://developers.printify.com/)
PRINTIFY_API_TOKEN=your-printify-jwt-token
PRINTIFY_SHOP_ID=12345678
# Example Blueprint IDs: 12 (Bella+Canvas 3001 Tee), 49 (Gildan 18000 Sweatshirt), 68 (Mug 11oz)
DEFAULT_BLUEPRINT_ID=12
DEFAULT_PRINT_PROVIDER_ID=99

# Etsy Open API v3 (https://developers.etsy.com/)
# Both are required: Etsy expects the x-api-key header as "keystring:shared_secret".
ETSY_API_KEYSTRING=your-etsy-keystring
ETSY_SHARED_SECRET=your-etsy-shared-secret
ETSY_SHOP_ID=87654321
ETSY_OAUTH_ACCESS_TOKEN=your-etsy-oauth-token

# Pipeline Thresholds
MIN_RENDER_CONFIDENCE=0.75
AUTO_PUBLISH_ENABLED=false

# Containerized Storage (Docker Local / Cloud PostgreSQL & S3-Compatible Object Storage)
DATABASE_URL=postgresql://etsy_admin:etsy_secret_password@localhost:5434/etsy_pod_db
S3_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=etsy-renders
S3_REGION=us-east-1
